# Copy this file to .env and fill in your environment values.
# .env is gitignored and must never be committed.

# Domain Configuration
# DOMAIN may be a NetBIOS name (EXAMPLE) or a DNS name (example.com).
DOMAIN=example.com
DC_SERVER=dc01.example.com
# Optional. Defaults to \\DC_SERVER\NETLOGON.
NETLOGON_PATH=\\dc01.example.com\NETLOGON
# Optional. Use these when DOMAIN is a NetBIOS name and cannot be derived.
# DOMAIN_FQDN=example.com
# NETBIOS_DOMAIN=EXAMPLE

# LDAP Configuration
LDAP_SERVER=ldap.example.com
LDAP_PORT=389
USE_SSL=false
LDAP_DISPLAY_NAME=Company Directory

# Deployment credentials (used only for the SMB mapping to NETLOGON).
# Leave blank to use the current Windows account.
USERNAME=
PASSWORD=

# GPO Configuration
# Optional. Defaults to "Outlook LDAP Address Book Deployment".
GPO_NAME=Outlook LDAP Address Book Deployment
TARGET_OU=OU=Users,DC=example,DC=com
